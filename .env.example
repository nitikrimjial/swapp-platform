# Copy to .env (never commit .env) and adjust. Used by docker-compose and documented in README.

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/swapp
DB_USERNAME=swapp
DB_PASSWORD=change-me

# --- Security ---
# At least 32 random bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=P7D
# true in production (HTTPS only)
COOKIE_SECURE=false
# Comma-separated list of origins allowed to call the API from browsers
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Storage ---
# database (default; images persist with PostgreSQL) or filesystem (needs a persistent volume)
STORAGE_TYPE=database
STORAGE_LOCAL_DIR=./data/uploads

# --- Runtime ---
PORT=8080
SPRING_PROFILES_ACTIVE=default

# --- Site and email ---
# Base URL used in links inside emails (Render sets RENDER_EXTERNAL_URL, which is used when this is empty)
PUBLIC_URL=http://localhost:8080
# Public contact for privacy questions and grievances, shown on the Privacy Policy
CONTACT_EMAIL=gamers3988@gmail.com
# log (emails go to the application log) or smtp (real delivery)
MAIL_PROVIDER=log
MAIL_FROM=no-reply@swapp.example
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# true once SMTP works: unconfirmed members cannot post, offer, request, message or report
REQUIRE_EMAIL_VERIFICATION=false

# --- Sign in with Google (optional; leave blank to hide the button) ---
# Google Cloud Console > APIs and Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: http://localhost:8080/login/oauth2/code/google (and the same path on the live URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
